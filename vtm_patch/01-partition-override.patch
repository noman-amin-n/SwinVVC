+// 310723-tanvir added
+void EncModeCtrl::ChangeTestMode(int mode)
+{
+  {
+    EncTestMode ENMode = m_ComprCUCtxList.back().testModes.back();
+
+    while (!m_ComprCUCtxList.back().testModes.empty())
+    {
+      m_ComprCUCtxList.back().testModes.pop_back();
+    }
+
+    m_ComprCUCtxList.back().testModes.push_back(ENMode);
+    m_ComprCUCtxList.back().testModes.back().type = ETM_INTRA;
+    if (mode == 0)
+    {
+      m_ComprCUCtxList.back().testModes.back().type = ETM_INTRA;
+    }
+    else if (mode == 1)
+    {
+      m_ComprCUCtxList.back().testModes.back().type = ETM_SPLIT_QT;
+    }
+    else if (mode == 2)
+    {
+      m_ComprCUCtxList.back().testModes.back().type = ETM_SPLIT_BT_H;
+    }
+    else if (mode == 3)
+    {
+      m_ComprCUCtxList.back().testModes.back().type = ETM_SPLIT_BT_V;
+    }
+    else if (mode == 4)
+    {
+      m_ComprCUCtxList.back().testModes.back().type = ETM_SPLIT_TT_H;
+    }
+    else if (mode == 5)
+    {
+      m_ComprCUCtxList.back().testModes.back().type = ETM_SPLIT_TT_V;
+    }
+  }
+}
+
+void EncModeCtrl::Modify(CodingStructure* cs, Partitioner& partitioner)
+{
+  if (!tryModeMaster(currTestMode(), *cs, partitioner))
+  {
+    m_ComprCUCtxList.back().testModes.pop_back();
+    m_ComprCUCtxList.back().testModes.back() = ETM_INTRA;
+    m_ComprCUCtxList.back().testModes.push_back(ETM_SPLIT_QT);
+    m_ComprCUCtxList.back().testModes.push_back(ETM_SPLIT_BT_H);
+    m_ComprCUCtxList.back().testModes.push_back(ETM_SPLIT_BT_V);
+    m_ComprCUCtxList.back().testModes.push_back(ETM_SPLIT_TT_H);
+    m_ComprCUCtxList.back().testModes.push_back(ETM_SPLIT_TT_V);
+  }
+}
+// 310723-tanvir ended
